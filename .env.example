# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-random-32-char-string

# Database (Neon connection string)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/yomu_test

# JWT
JWT_SECRET=change-me-too
JWT_EXPIRES_IN=7d

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Where the frontend lives, for post-login redirect + CORS — defaults to
# this app's own origin now that the test harness in public/ is served from here
CLIENT_URL=http://localhost:3000
